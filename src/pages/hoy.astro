---
import Base from '../layouts/Base.astro';
import MatchCard from '../components/MatchCard.astro';
import { getMatches, getUniqueLeagues, groupByLeague } from '../utils/matches';
import { leagueFlags, leagueSlug, toSlug } from '../utils/seo';

const events = getMatches();
const grouped = groupByLeague();
const featuredLeagues = getUniqueLeagues().slice(0, 6);

const now = new Date();
const todayDisplay = now.toLocaleDateString('es-AR', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const todayISO = now.toISOString().split('T')[0];

const title = `Partidos de Hoy en Vivo 🔴 ${todayDisplay} | Rojadirecta`;
const description = `Ver todos los partidos de hoy ${todayDisplay} en vivo gratis. ${events.length} partidos disponibles con foco en Liga MX, Argentina, Brasil, Colombia, Chile, Ecuador y MLS.`;
const canonicalUrl = 'https://rojadirectaenvivo.top/hoy/';

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `Partidos de Hoy - ${todayDisplay}`,
  "description": description,
  "url": canonicalUrl,
  "datePublished": todayISO,
  "dateModified": todayISO,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": events.length,
    "itemListElement": events.map((match: any, index: number) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://rojadirectaenvivo.top/partido/${toSlug(match)}/`,
      "name": match.teams
    }))
  }
};
---

<Base title={title} description={description} canonicalUrl={canonicalUrl} matchSchema={pageSchema}>
  <div class="container" style="padding-top: 32px;">
    <nav class="match-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <span>Partidos de Hoy</span>
    </nav>

    <h1 class="keyword-h1" style="font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 8px;">
      ⚽ Partidos de Hoy en Vivo
    </h1>
    <p class="keyword-sub" style="margin-bottom: 8px;">
      {events.length} partidos disponibles — ver en vivo gratis hoy
    </p>
    <p style="color: var(--c-text-muted); font-size: 13px; text-align: center; margin-bottom: 24px;">
      📅 <time datetime={todayISO}>{todayDisplay}</time> · Actualizado cada 3 horas
    </p>

    {featuredLeagues.length > 0 && (
      <div style="display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 24px;">
        {featuredLeagues.map((league) => (
          <a href={`/liga/${leagueSlug(league)}/`} class="channel-badge" style="text-decoration: none;">
            {leagueFlags[league] || '⚽'} {league}
          </a>
        ))}
      </div>
    )}

    {events.length === 0 ? (
      <div style="text-align: center; padding: 64px 0;">
        <p style="color: var(--c-text-secondary); font-size: 16px;">No hay partidos disponibles en este momento.</p>
        <p style="color: var(--c-text-muted); font-size: 13px; margin-top: 8px;">Los partidos se actualizan cada 3 horas.</p>
      </div>
    ) : (
      <div>
        {Object.entries(grouped).map(([leagueName, leagueMatches]) => (
          <section>
            <div class="country-group-header">
              <span style="font-size: 20px;">{leagueFlags[leagueName] || '⚽'}</span>
              <a href={`/liga/${leagueSlug(leagueName)}/`} class="country-name" style="text-decoration: none; color: inherit;">
                {leagueName}
              </a>
              <div class="divider-line"></div>
              <span class="match-count">{leagueMatches.length} partidos</span>
            </div>

            <div class="match-grid">
              {leagueMatches.map((event: any) => (
                <MatchCard
                  id={event.id}
                  slug={toSlug(event)}
                  title={`${event.league}: ${event.teams}`}
                  league={event.league}
                  teams={event.teams}
                  time={event.time}
                  date={event.date}
                  channels={event.channels}
                />
              ))}
            </div>
          </section>
        ))}
      </div>
    )}

    <section class="seo-text">
      <h2>Partidos de Hoy en Vivo — {todayDisplay}</h2>
      <p>
        Bienvenido a la página de <strong>partidos de hoy</strong> en <strong>Rojadirecta en Vivo</strong>.
        Aquí encontrarás todos los partidos del día transmitidos en vivo y en directo. Esta página
        se regenera automáticamente para mostrarte siempre los eventos más recientes.
      </p>
      <p>
        No te pierdas ningún partido: desde <strong>Liga MX</strong>, <strong>fútbol argentino</strong> y
        <strong> Brasileirão</strong> hasta <strong>MLS</strong>, <strong>NBA</strong> y <strong>Copa Libertadores</strong>.
        Todo gratis, sin registro y en español para búsquedas tipo <strong>Pirlo TV</strong> o <strong>Fútbol Libre</strong>.
      </p>
    </section>

    <section class="seo-text" style="margin-top: 24px;">
      <h3>Preguntas Frecuentes</h3>
      <details style="margin-bottom: 12px;">
        <summary style="cursor: pointer; font-weight: 600; color: var(--c-text-primary);">
          ¿Dónde ver los partidos de hoy en vivo gratis?
        </summary>
        <p style="margin-top: 8px;">
          En rojadirectaenvivo.top puedes ver todos los partidos de hoy en vivo gratis.
          Ofrecemos múltiples canales de transmisión para cada partido sin necesidad de registro.
        </p>
      </details>
      <details style="margin-bottom: 12px;">
        <summary style="cursor: pointer; font-weight: 600; color: var(--c-text-primary);">
          ¿Cada cuánto se actualizan los partidos?
        </summary>
        <p style="margin-top: 8px;">
          Los partidos se actualizan automáticamente con el feed más reciente. Vuelve regularmente
          para ver los últimos eventos disponibles.
        </p>
      </details>
      <details>
        <summary style="cursor: pointer; font-weight: 600; color: var(--c-text-primary);">
          ¿Puedo ver partidos en mi celular?
        </summary>
        <p style="margin-top: 8px;">
          Sí, rojadirectaenvivo.top está completamente optimizado para celulares y tablets.
          Puedes ver todos los partidos en vivo desde cualquier dispositivo.
        </p>
      </details>
    </section>
  </div>
</Base>
