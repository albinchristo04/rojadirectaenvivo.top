---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import RelatedMatches from '../components/RelatedMatches.astro';
import InternalLinks from '../components/InternalLinks.astro';
import { getMatches } from '../utils/matches';
import { buildBreadcrumbSchema } from '../utils/seo';

const events = getMatches();

const title = 'Fútbol Libre Hoy | Liga MX, Argentina y Libertadores en Vivo';
const description = 'Fútbol Libre hoy para ver partidos en vivo gratis de Liga MX, Argentina, Brasil, Colombia, Ecuador, Chile, MLS y copas. Alternativa en español a Pirlo TV y Rojadirecta.';
const canonicalUrl = 'https://rojadirectaenvivo.top/futbol-libre/';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://rojadirectaenvivo.top/' },
  { name: 'Fútbol Libre', url: canonicalUrl },
];

const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Fútbol Libre',
  description,
  url: canonicalUrl,
  inLanguage: 'es',
  about: [
    { '@type': 'Thing', name: 'Fútbol Libre' },
    { '@type': 'Thing', name: 'Liga MX' },
    { '@type': 'Thing', name: 'Liga Profesional Argentina' },
    { '@type': 'Thing', name: 'Brasileirao' },
    { '@type': 'Thing', name: 'Copa Libertadores' },
  ],
};

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: canonicalUrl,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.keyword-h1', '.keyword-sub', '.bing-resumen', '.keyword-text'],
  },
};

const faqs = [
  {
    question: '¿Dónde ver Fútbol Libre hoy?',
    answer: 'En rojadirectaenvivo.top puedes ver Fútbol Libre hoy con una agenda en español, horarios, páginas por partido y enfoque en ligas latinoamericanas como Liga MX, Argentina, Brasil, Colombia, Ecuador, Chile y MLS.',
  },
  {
    question: '¿Cómo ver Fútbol Libre en vivo hoy?',
    answer: 'Solo entra al sitio, elige el partido y abre la transmisión disponible. Cada encuentro tiene varios canales cuando el feed los ofrece y se actualiza automáticamente.',
  },
  {
    question: '¿Fútbol Libre sirve para ver Libertadores y Liga MX?',
    answer: 'Sí. Esta página está optimizada para consultas como Fútbol Libre Liga MX, Fútbol Libre Libertadores y Fútbol Libre hoy, con enlaces internos hacia los hubs más buscados.',
  },
  {
    question: '¿Fútbol Libre funciona desde el celular?',
    answer: 'Sí. El sitio está preparado para celular, tablet y computadora sin descargar ninguna app ni crear cuenta.',
  },
];

const hubLinks = [
  { label: '🇲🇽 Liga MX', href: '/liga/liga-mx/' },
  { label: '🇦🇷 Liga Argentina', href: '/liga/liga-profesional-argentina/' },
  { label: '🇧🇷 Brasileirão', href: '/liga/brasileirao/' },
  { label: '🇨🇴 Liga BetPlay', href: '/liga/liga-betplay-dimayor/' },
  { label: '🇪🇨 LigaPro Ecuador', href: '/liga/ligapro-ecuador/' },
  { label: '🇨🇱 Chile', href: '/liga/primera-division-chile/' },
  { label: '🌎 Copa Libertadores', href: '/liga/copa-libertadores/' },
  { label: '📅 Partidos de Hoy', href: '/partidos-de-hoy/' },
];

const internalLinks = [
  { label: '🔴 Rojadirecta en Vivo', href: '/rojadirecta-en-vivo/' },
  { label: '🟥 Tarjeta Roja', href: '/tarjeta-roja/' },
  { label: '📺 Pirlo TV', href: '/pirlo-tv/' },
  { label: '⚽ Fútbol en Vivo', href: '/futbol-en-vivo/' },
  { label: '🆓 Fútbol en Vivo Gratis', href: '/futbol-en-vivo-gratis/' },
  { label: '👀 Ver Fútbol Online', href: '/ver-futbol/' },
  { label: '📆 Hoy', href: '/hoy/' },
];
---

<Base title={title} description={description} canonicalUrl={canonicalUrl} matchSchema={pageSchema}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} slot="head" />

  <div class="container" style="padding-top: 32px;">
    <Breadcrumb items={breadcrumbs} />

    <section class="keyword-hero">
      <h1 class="keyword-h1">Fútbol Libre</h1>
      <p class="keyword-sub">Fútbol Libre hoy con foco en México, Argentina, Brasil y Copa Libertadores</p>
    </section>

    <section class="seo-text bing-resumen" style="margin-top: 0; margin-bottom: 24px;">
      <h2>Resumen rápido</h2>
      <p>
        Esta página responde a búsquedas como <strong>Fútbol Libre hoy</strong>, <strong>Fútbol Libre Liga MX</strong>
        y <strong>Fútbol Libre Libertadores</strong> con una agenda clara, en español y orientada al público latinoamericano.
      </p>
    </section>

    <div class="keyword-text">
      <p>
        <strong>Fútbol Libre</strong> es una de las consultas más comunes cuando alguien quiere ver <strong>partidos en vivo gratis</strong>
        sin perder tiempo. En <strong>rojadirectaenvivo.top</strong> tomamos esa intención y la convertimos en páginas fáciles de rastrear,
        con horarios, ligas, equipos y partidos organizados para responder rápido.
      </p>

      <p>
        Nuestro foco principal está en las búsquedas de <strong>Latinoamérica</strong>. Por eso el contenido destaca
        <strong> Liga MX</strong>, <strong>fútbol argentino</strong>, <strong>Brasileirão</strong>,
        <strong> Liga BetPlay Colombia</strong>, <strong>LigaPro Ecuador</strong>, <strong>Chile</strong>,
        <strong> Uruguay</strong>, <strong>MLS</strong> y las competiciones como <strong>Copa Libertadores</strong>
        y <strong>Copa Sudamericana</strong>.
      </p>

      <p>
        Si buscas <strong>futbol libre tv</strong>, aquí no solo encuentras una portada con muchos enlaces.
        Cada partido tiene su propia URL y cada liga importante dispone de su hub. Eso mejora la navegación del usuario
        y también hace más fácil que los buscadores entiendan qué página responde mejor a cada consulta.
      </p>

      <p>
        La experiencia está pensada para celular y escritorio, sin registros ni descargas. Si un usuario llega buscando
        <strong>Fútbol Libre en vivo hoy</strong>, debe poder identificar en segundos qué partidos hay, de qué liga son,
        a qué hora juegan y qué canal tiene disponible. Ese es el objetivo de esta landing.
      </p>
    </div>

    <InternalLinks links={hubLinks} title="Hubs LATAM destacados" />

    <RelatedMatches matches={events} title="Fútbol Libre Hoy — Partidos en Vivo" />

    <FAQ items={faqs} />

    <InternalLinks links={internalLinks} title="Más páginas relacionadas" />

    <div style="text-align: center; margin-top: 32px; margin-bottom: 32px;">
      <a href="/" style="color: var(--c-accent); text-decoration: none; font-weight: 600;">
        ← Ver todos los partidos
      </a>
      <span style="margin: 0 16px; color: var(--c-text-muted);">|</span>
      <a href="/hoy/" style="color: var(--c-accent); text-decoration: none; font-weight: 600;">
        Partidos de Hoy →
      </a>
    </div>
  </div>
</Base>
