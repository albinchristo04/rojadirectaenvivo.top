---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import RelatedMatches from '../components/RelatedMatches.astro';
import InternalLinks from '../components/InternalLinks.astro';
import { getMatches } from '../utils/matches';
import { buildBreadcrumbSchema } from '../utils/seo';

const events = getMatches();

const title = 'Fútbol en Vivo Hoy | Liga MX, Argentina y Libertadores Gratis';
const description = 'Fútbol en vivo hoy con partidos de Liga MX, Argentina, Brasil, Colombia, Ecuador, Chile, MLS y copas. Página en español para búsquedas tipo Rojadirecta, Tarjeta Roja y Pirlo TV.';
const canonicalUrl = 'https://rojadirectaenvivo.top/futbol-en-vivo/';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://rojadirectaenvivo.top/' },
  { name: 'Fútbol en Vivo', url: canonicalUrl },
];

const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Fútbol en Vivo',
  description,
  url: canonicalUrl,
  inLanguage: 'es',
  about: [
    { '@type': 'Thing', name: 'Fútbol en vivo' },
    { '@type': 'Thing', name: 'Liga MX' },
    { '@type': 'Thing', name: 'Liga Profesional Argentina' },
    { '@type': 'Thing', name: 'Brasileirao' },
    { '@type': 'Thing', name: 'Copa Libertadores' },
  ],
};

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: canonicalUrl,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.keyword-h1', '.keyword-sub', '.bing-resumen', '.keyword-text'],
  },
};

const faqs = [
  {
    question: '¿Dónde ver fútbol en vivo hoy?',
    answer: 'Puedes ver fútbol en vivo hoy gratis en rojadirectaenvivo.top. Priorizamos partidos de Liga MX, Argentina, Brasil, Colombia, Ecuador, Chile, MLS y copas, con páginas internas por liga y partido.',
  },
  {
    question: '¿Es gratis ver fútbol en vivo?',
    answer: 'Sí, todas las transmisiones en rojadirectaenvivo.top son completamente gratuitas. No necesitas registrarte ni pagar ninguna suscripción para ver los partidos.',
  },
  {
    question: '¿Qué ligas puedo ver en vivo?',
    answer: 'Puedes ver Liga MX, Liga Profesional Argentina, Brasileirão, Liga BetPlay, LigaPro Ecuador, Chile, MLS, Copa Libertadores, Copa Sudamericana, además de varias ligas europeas y otros deportes.',
  },
  {
    question: '¿Puedo ver fútbol en vivo desde el celular?',
    answer: 'Sí, nuestra plataforma funciona perfectamente en celulares, tablets y computadoras. No necesitas descargar ninguna aplicación.',
  },
  {
    question: '¿Qué secciones priorizan hoy?',
    answer: `Hoy mostramos ${events.length} partidos y damos prioridad editorial a los hubs de Liga MX, fútbol argentino, Brasileirão, Colombia, Ecuador, Chile, MLS y Copa Libertadores.`,
  },
];

const hubLinks = [
  { label: '🇲🇽 Liga MX', href: '/liga/liga-mx/' },
  { label: '🇦🇷 Liga Argentina', href: '/liga/liga-profesional-argentina/' },
  { label: '🇧🇷 Brasileirão', href: '/liga/brasileirao/' },
  { label: '🇨🇴 Liga BetPlay', href: '/liga/liga-betplay-dimayor/' },
  { label: '🇪🇨 LigaPro Ecuador', href: '/liga/ligapro-ecuador/' },
  { label: '🇺🇸 MLS', href: '/liga/mls/' },
  { label: '🌎 Copa Libertadores', href: '/liga/copa-libertadores/' },
  { label: '📅 Partidos de Hoy', href: '/partidos-de-hoy/' },
];

const internalLinks = [
  { label: '⚽ Fútbol Libre', href: '/futbol-libre/' },
  { label: '🔴 Rojadirecta en Vivo', href: '/rojadirecta-en-vivo/' },
  { label: '🟥 Tarjeta Roja', href: '/tarjeta-roja/' },
  { label: '📺 Pirlo TV', href: '/pirlo-tv/' },
  { label: '📅 Partidos de Hoy', href: '/partidos-de-hoy/' },
  { label: '🆓 Fútbol en Vivo Gratis', href: '/futbol-en-vivo-gratis/' },
  { label: '👀 Ver Fútbol Online', href: '/ver-futbol/' },
];
---

<Base title={title} description={description} canonicalUrl={canonicalUrl} matchSchema={pageSchema}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} slot="head" />
  <div class="container" style="padding-top: 32px;">
    <Breadcrumb items={breadcrumbs} />

    <section class="keyword-hero">
      <h1 class="keyword-h1">Fútbol en Vivo</h1>
      <p class="keyword-sub">Fútbol en vivo hoy con prioridad para México, Argentina, Brasil y Libertadores</p>
    </section>

    <section class="seo-text bing-resumen" style="margin-top: 0; margin-bottom: 24px;">
      <h2>Resumen rápido</h2>
      <p>
        Esta página responde a búsquedas como <strong>fútbol en vivo hoy</strong> y <strong>ver partidos en directo gratis</strong>
        con una agenda en español y enlaces rápidos a los torneos con más demanda en Latinoamérica.
      </p>
    </section>

    <div class="keyword-text">
      <p>
        Bienvenido a la mejor plataforma de <strong>fútbol en vivo</strong> en español. En <strong>rojadirectaenvivo.top</strong>
        encontrarás los partidos del día con transmisiones en directo y una estructura pensada para resolver rápido la búsqueda.
        No importa si buscas <strong>fútbol en vivo hoy</strong>, <strong>futbol en vivo gratis</strong> o simplemente
        <strong>ver fútbol online</strong>: la página está escrita para responder a esa intención.
      </p>

      <p>
        La prioridad editorial está en <strong>Liga MX</strong>, <strong>fútbol argentino</strong>,
        <strong> Brasileirão</strong>, <strong>Liga BetPlay Colombia</strong>, <strong>LigaPro Ecuador</strong>,
        <strong> Chile</strong>, <strong>MLS</strong> y <strong>Copa Libertadores</strong>. Luego entran las ligas europeas y otros deportes.
      </p>

      <p>
        A diferencia de otros sitios de <strong>fútbol en vivo</strong>, en rojadirectaenvivo.top ofrecemos
        múltiples opciones de canales por partido cuando el feed las trae. Si una transmisión no funciona, simplemente prueba otra.
        Además, cada liga importante tiene su propio hub para que Bing y el usuario lleguen a una página más precisa.
      </p>

      <p>
        Ya sea que busques <strong>rojadirecta</strong>, <strong>tarjeta roja en vivo</strong>,
        <strong>pirlo tv</strong> o <strong>fútbol libre</strong>, aquí encontrarás una experiencia enfocada en
        <strong> fútbol en vivo gratis hoy</strong> con especial atención al público de Latinoamérica.
      </p>
    </div>

    <InternalLinks links={hubLinks} title="Ligas destacadas en fútbol en vivo" />

    <RelatedMatches matches={events} title="Fútbol en Vivo Hoy" />

    <FAQ items={faqs} />

    <InternalLinks links={internalLinks} />

    <div style="text-align: center; margin-top: 32px; margin-bottom: 32px;">
      <a href="/" style="color: var(--c-accent); text-decoration: none; font-weight: 600;">
        ← Ver todos los partidos
      </a>
      <span style="margin: 0 16px; color: var(--c-text-muted);">|</span>
      <a href="/hoy/" style="color: var(--c-accent); text-decoration: none; font-weight: 600;">
        Partidos de Hoy →
      </a>
    </div>
  </div>
</Base>
