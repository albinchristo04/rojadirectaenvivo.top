---
import Base from '../../layouts/Base.astro';
import MatchCard from '../../components/MatchCard.astro';
import matchDataRaw from '../../data/matches.json';
import { detectSportEs, leagueFlags, leagueSlug, toSlug } from '../../utils/seo';
import { FEATURED_LEAGUE_ORDER, sortLeagueNames, sortMatchesChronologically } from '../../utils/matches';

const allEvents = matchDataRaw.events || [];
const allLeagueNames = sortLeagueNames([
  ...FEATURED_LEAGUE_ORDER,
  ...allEvents.map((event: any) => event.league).filter(Boolean),
]);

export function getStaticPaths() {
  const events = matchDataRaw.events || [];
  const leagueNames = sortLeagueNames([
    ...FEATURED_LEAGUE_ORDER,
    ...events.map((event: any) => event.league).filter(Boolean),
  ]);
  return leagueNames.map((leagueName) => ({
    params: { slug: leagueSlug(leagueName) },
    props: {
      leagueName,
      matches: sortMatchesChronologically(events.filter((event: any) => event.league === leagueName)),
    },
  }));
}

const { leagueName, matches } = Astro.props;
const slug = leagueSlug(leagueName);
const orderedMatches = sortMatchesChronologically(matches);
const emoji = leagueFlags[leagueName] || '⚽';
const otherLeagues = allLeagueNames.filter((league) => league !== leagueName).slice(0, 8);
const isLatamHub = /Liga MX|Argentina|Brasileirao|Betplay|LigaPro|Chile|Uruguay|Libertadores|Sudamericana|MLS/i.test(leagueName);
const sportName = detectSportEs(leagueName);

const title = `${leagueName} en Vivo 🔴 Fútbol Libre y Pirlo TV | Rojadirecta`;
const description = orderedMatches.length > 0
  ? `Ver ${orderedMatches.length} partidos de ${leagueName} en vivo hoy. Horarios, canales y enlaces actualizados en Rojadirecta en Vivo, Pirlo TV y Fútbol Libre.`
  : `Hub de ${leagueName} en vivo con horarios, canales y próximas transmisiones. Página en español enfocada en Bing para búsquedas como Pirlo TV, Fútbol Libre y Roja Directa.`;
const canonicalUrl = `https://rojadirectaenvivo.top/liga/${slug}/`;

const leagueSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${leagueName} en Vivo`,
  "description": description,
  "url": canonicalUrl,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": orderedMatches.length,
    "itemListElement": orderedMatches.map((match: any, index: number) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://rojadirectaenvivo.top/partido/${toSlug(match)}/`,
      "name": match.teams
    }))
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://rojadirectaenvivo.top/" },
    { "@type": "ListItem", "position": 2, "name": leagueName, "item": canonicalUrl }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `¿Dónde ver ${leagueName} en vivo?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `En esta página reunimos horarios, canales y enlaces de ${leagueName} en vivo. El hub está optimizado para búsquedas en Bing como Pirlo TV, Fútbol Libre y Roja Directa.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Cuántos partidos hay hoy de ${leagueName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Actualmente hay ${orderedMatches.length} partidos visibles en el hub de ${leagueName}. El número cambia cuando llega nueva programación al feed.`
      }
    }
  ]
};

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "url": canonicalUrl,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".keyword-h1", ".keyword-sub", ".seo-text", ".hub-resumen"]
  }
};
---

<Base title={title} description={description} canonicalUrl={canonicalUrl} matchSchema={leagueSchema}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} slot="head" />

  <div class="container" style="padding-top: 32px;">
    <nav class="match-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Inicio</a>
      <span>›</span>
      <span>{leagueName}</span>
    </nav>

    <h1 class="keyword-h1" style="font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 8px;">
      {emoji} {leagueName} en Vivo
    </h1>
    <p class="keyword-sub" style="margin-bottom: 32px;">
      {orderedMatches.length > 0 ? `${orderedMatches.length} partidos de ${leagueName} disponibles — ver en vivo gratis` : `Hub de ${leagueName} preparado para próximos partidos y búsquedas en Bing`}
    </p>

    <section class="seo-text hub-resumen" style="margin-top: 0; margin-bottom: 24px;">
      <p>
        {isLatamHub
          ? `Este hub concentra horarios, canales y enlaces de ${leagueName} para usuarios que buscan fútbol latinoamericano en español.`
          : `Este hub concentra horarios, canales y enlaces de ${leagueName} con texto claro y estructura preparada para Bing y citas de IA.`}
      </p>
    </section>

    {orderedMatches.length > 0 ? (
      <div class="match-grid">
        {orderedMatches.map((event: any) => (
          <MatchCard
            id={event.id}
            slug={toSlug(event)}
            title={`${event.league}: ${event.teams}`}
            league={event.league}
            teams={event.teams}
            time={event.time}
            date={event.date}
            channels={event.channels}
          />
        ))}
      </div>
    ) : (
      <div style="text-align: center; padding: 32px 0 16px;">
        <p style="color: var(--c-text-secondary); font-size: 16px;">No hay partidos publicados ahora mismo para {leagueName}.</p>
        <p style="color: var(--c-text-muted); font-size: 13px; margin-top: 8px;">El hub seguirá activo y se llenará automáticamente cuando aparezcan nuevos encuentros.</p>
      </div>
    )}

    <section class="seo-text">
      <h2>Ver {leagueName} en Vivo Gratis</h2>
      <p>
        Bienvenido a la página de <strong>{leagueName}</strong> en <strong>Rojadirecta en Vivo</strong>.
        Aquí encontrarás los partidos de {sportName} de <strong>{leagueName}</strong> con horarios,
        canales y enlaces actualizados. Similar a <strong>Tarjeta Roja</strong>, <strong>Pirlo TV</strong>
        y <strong>Fútbol Libre</strong>, ofrecemos una página clara para ver {sportName} en vivo gratis.
      </p>
      <p>
        Todos los partidos se actualizan automáticamente con cada nueva importación del feed.
        Vuelve a esta página regularmente para ver los próximos partidos de <strong>{leagueName}</strong>.
        En <strong>rojadirectaenvivo.top</strong> encontrarás transmisiones de {sportName} en vivo,
        con copy en español y estructura lista para Bing Copilot y otras herramientas de cita.
      </p>
    </section>

    <section class="seo-text faq-section" style="margin-top: 24px;">
      <h3>Preguntas Frecuentes</h3>
      <details style="margin-bottom: 12px;" open>
        <summary style="cursor: pointer; font-weight: 600; color: var(--c-text-primary);">
          ¿Dónde ver {leagueName} en vivo gratis?
        </summary>
        <p style="margin-top: 8px;">
          En esta página mostramos horarios, canales y partidos disponibles de {leagueName}. El objetivo es responder rápido a búsquedas como Pirlo TV, Fútbol Libre y Roja Directa.
        </p>
      </details>
      <details>
        <summary style="cursor: pointer; font-weight: 600; color: var(--c-text-primary);">
          ¿Cuántos partidos hay ahora mismo?
        </summary>
        <p style="margin-top: 8px;">
          El hub de {leagueName} tiene {orderedMatches.length} partidos visibles en este momento. Cuando el feed cambia, este número también cambia.
        </p>
      </details>
    </section>

    {otherLeagues.length > 0 && (
      <section class="seo-text" style="margin-top: 24px;">
        <h3>Otras Ligas en Vivo</h3>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px;">
          {otherLeagues.map((league: string) => (
            <a href={`/liga/${leagueSlug(league)}/`} class="channel-badge" style="text-decoration: none;">
              {leagueFlags[league] || '⚽'} {league}
            </a>
          ))}
        </div>
      </section>
    )}

    <div style="text-align: center; margin-top: 32px; margin-bottom: 32px;">
      <a href="/" style="color: var(--c-accent); text-decoration: none; font-weight: 600;">
        ← Ver todos los partidos de hoy
      </a>
      <span style="margin: 0 16px; color: var(--c-text-muted);">|</span>
      <a href="/hoy/" style="color: var(--c-accent); text-decoration: none; font-weight: 600;">
        Partidos de Hoy →
      </a>
    </div>
  </div>
</Base>
