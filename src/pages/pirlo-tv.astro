---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import RelatedMatches from '../components/RelatedMatches.astro';
import InternalLinks from '../components/InternalLinks.astro';
import { getMatches } from '../utils/matches';
import { buildBreadcrumbSchema } from '../utils/seo';

const events = getMatches();

const title = 'Pirlo TV en Vivo Hoy | Liga MX, Libertadores y Fútbol Libre';
const description = 'Pirlo TV en vivo hoy con partidos de Liga MX, Argentina, Brasil, Colombia, Ecuador, Chile, MLS y copas. Rojadirecta, Fútbol Libre y Tarjeta Roja en español.';
const canonicalUrl = 'https://rojadirectaenvivo.top/pirlo-tv/';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://rojadirectaenvivo.top/' },
  { name: 'Pirlo TV', url: canonicalUrl },
];

const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Pirlo TV en Vivo',
  description,
  url: canonicalUrl,
  inLanguage: 'es',
  about: [
    { '@type': 'Thing', name: 'Pirlo TV' },
    { '@type': 'Thing', name: 'Fútbol Libre' },
    { '@type': 'Thing', name: 'Rojadirecta en Vivo' },
    { '@type': 'Thing', name: 'Liga MX' },
    { '@type': 'Thing', name: 'Copa Libertadores' },
  ],
};

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: canonicalUrl,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.keyword-h1', '.keyword-sub', '.bing-resumen', '.keyword-text'],
  },
};

const faqs = [
  {
    question: '¿Dónde ver Pirlo TV en vivo hoy?',
    answer: 'En rojadirectaenvivo.top puedes ver Pirlo TV en vivo hoy con horarios, enlaces y canales actualizados para los partidos del día, especialmente de Liga MX, Argentina, Brasil, Colombia, Ecuador, Chile, MLS y copas.',
  },
  {
    question: '¿Pirlo TV sirve para fútbol latinoamericano?',
    answer: 'Sí. Esta página está pensada para usuarios que buscan Pirlo TV para ver fútbol latinoamericano en español, con foco en ligas de México, Argentina, Brasil, Colombia, Ecuador, Chile, Uruguay y torneos continentales.',
  },
  {
    question: '¿Pirlo TV sigue funcionando?',
    answer: 'El nombre Pirlo TV sigue concentrando búsquedas, pero aquí reunimos una alternativa estable con páginas propias por partido, hubs por liga y varias opciones de canal sin registro.',
  },
  {
    question: '¿Qué partidos aparecen hoy en Pirlo TV?',
    answer: `Hoy mostramos ${events.length} partidos disponibles con actualización automática del feed. Cada partido tiene horario, canales y una página individual para encontrar la transmisión rápida.` ,
  },
];

const hubLinks = [
  { label: '🇲🇽 Liga MX', href: '/liga/liga-mx/' },
  { label: '🇦🇷 Liga Argentina', href: '/liga/liga-profesional-argentina/' },
  { label: '🇧🇷 Brasileirão', href: '/liga/brasileirao/' },
  { label: '🇨🇴 Liga BetPlay', href: '/liga/liga-betplay-dimayor/' },
  { label: '🇪🇨 LigaPro Ecuador', href: '/liga/ligapro-ecuador/' },
  { label: '🇺🇸 MLS', href: '/liga/mls/' },
  { label: '🌎 Copa Libertadores', href: '/liga/copa-libertadores/' },
  { label: '📅 Partidos de Hoy', href: '/hoy/' },
];

const internalLinks = [
  { label: '⚽ Fútbol Libre', href: '/futbol-libre/' },
  { label: '🔴 Rojadirecta en Vivo', href: '/rojadirecta-en-vivo/' },
  { label: '🟥 Tarjeta Roja', href: '/tarjeta-roja/' },
  { label: '⚽ Fútbol en Vivo', href: '/futbol-en-vivo/' },
  { label: '🆓 Fútbol en Vivo Gratis', href: '/futbol-en-vivo-gratis/' },
  { label: '👀 Ver Fútbol Online', href: '/ver-futbol/' },
];
---

<Base title={title} description={description} canonicalUrl={canonicalUrl} matchSchema={pageSchema}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} slot="head" />

  <div class="container" style="padding-top: 32px;">
    <Breadcrumb items={breadcrumbs} />

    <section class="keyword-hero">
      <h1 class="keyword-h1">Pirlo TV</h1>
      <p class="keyword-sub">Pirlo TV en vivo hoy con foco en Liga MX, Libertadores y fútbol latinoamericano</p>
    </section>

    <section class="seo-text bing-resumen" style="margin-top: 0; margin-bottom: 24px;">
      <h2>Resumen rápido</h2>
      <p>
        Si buscas <strong>Pirlo TV en vivo hoy</strong>, esta página resume en español dónde ver los partidos del día,
        con prioridad para <strong>México</strong>, <strong>Argentina</strong>, <strong>Brasil</strong>,
        <strong> Colombia</strong>, <strong>Ecuador</strong>, <strong>Chile</strong>, <strong>MLS</strong>
        y <strong>Copa Libertadores</strong>.
      </p>
    </section>

    <div class="keyword-text">
      <p>
        <strong>Pirlo TV</strong> sigue siendo una de las búsquedas más fuertes para encontrar <strong>fútbol en vivo gratis</strong>.
        En <strong>rojadirectaenvivo.top</strong> reunimos esa intención en una página clara, en español y pensada para el público latinoamericano.
        Aquí no solo ves un listado genérico: encuentras <strong>horarios</strong>, <strong>canales</strong> y enlaces rápidos a cada partido.
      </p>

      <p>
        La mayor demanda llega desde consultas como <strong>pirlo tv liga mx</strong>, <strong>pirlo tv libertadores</strong>,
        <strong> pirlo tv futbol libre</strong> o <strong>pirlo tv roja directa</strong>. Por eso priorizamos partidos de
        <strong> Liga MX</strong>, <strong>fútbol argentino</strong>, <strong>Brasileirão</strong>,
        <strong> Liga BetPlay Colombia</strong>, <strong>LigaPro Ecuador</strong>, <strong>Chile</strong>,
        <strong> Uruguay</strong> y <strong>MLS</strong>, además de las grandes copas continentales.
      </p>

      <p>
        Cada encuentro visible en la cartelera tiene su propia página con información directa: quién juega, a qué hora,
        cuántos canales hay y dónde ver la transmisión. Eso hace que <strong>Pirlo TV hoy</strong> no sea solo una keyword,
        sino una puerta de entrada a páginas más precisas para equipos, ligas y partidos puntuales.
      </p>

      <p>
        Si lo que quieres es una alternativa estable a <strong>PirloTV</strong>, <strong>Fútbol Libre</strong>,
        <strong> Tarjeta Roja</strong> o <strong>Rojadirecta</strong>, aquí tienes una estructura más limpia para seguir el fútbol
        latinoamericano y europeo desde celular, tablet o computadora, sin registro y con copy pensado para resolver la búsqueda rápido.
      </p>
    </div>

    <InternalLinks links={hubLinks} title="Ligas destacadas para Pirlo TV" />

    <RelatedMatches matches={events} title="Pirlo TV Hoy — Partidos en Vivo" />

    <FAQ items={faqs} />

    <InternalLinks links={internalLinks} title="Más páginas relacionadas" />

    <div style="text-align: center; margin-top: 32px; margin-bottom: 32px;">
      <a href="/" style="color: var(--c-accent); text-decoration: none; font-weight: 600;">
        ← Ver todos los partidos
      </a>
      <span style="margin: 0 16px; color: var(--c-text-muted);">|</span>
      <a href="/tarjeta-roja/" style="color: var(--c-accent); text-decoration: none; font-weight: 600;">
        Tarjeta Roja →
      </a>
    </div>
  </div>
</Base>
