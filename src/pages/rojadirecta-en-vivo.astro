---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import RelatedMatches from '../components/RelatedMatches.astro';
import InternalLinks from '../components/InternalLinks.astro';
import { getMatches } from '../utils/matches';
import { buildBreadcrumbSchema } from '../utils/seo';

const events = getMatches();

const title = 'Rojadirecta en Vivo Hoy | Roja Directa, Liga MX y Libertadores';
const description = 'Rojadirecta en vivo hoy con partidos de Liga MX, Argentina, Brasil, Colombia, Ecuador, Chile, MLS y copas. Roja Directa en español con alternativa a Pirlo TV y Tarjeta Roja.';
const canonicalUrl = 'https://rojadirectaenvivo.top/rojadirecta-en-vivo/';

const breadcrumbs = [
  { name: 'Inicio', url: 'https://rojadirectaenvivo.top/' },
  { name: 'Rojadirecta en Vivo', url: canonicalUrl },
];

const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Rojadirecta en Vivo',
  description,
  url: canonicalUrl,
  inLanguage: 'es',
  about: [
    { '@type': 'Thing', name: 'Rojadirecta' },
    { '@type': 'Thing', name: 'Roja Directa' },
    { '@type': 'Thing', name: 'Liga MX' },
    { '@type': 'Thing', name: 'Liga Profesional Argentina' },
    { '@type': 'Thing', name: 'Copa Libertadores' },
  ],
};

const speakableSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: canonicalUrl,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.keyword-h1', '.keyword-sub', '.bing-resumen', '.keyword-text'],
  },
};

const faqs = [
  {
    question: '¿Dónde ver Rojadirecta en vivo hoy?',
    answer: 'En rojadirectaenvivo.top puedes ver Rojadirecta en vivo hoy con foco en partidos de Liga MX, Argentina, Brasil, Colombia, Ecuador, Chile, MLS y copas internacionales, todo en español.',
  },
  {
    question: '¿Rojadirecta todavía funciona?',
    answer: 'La marca Rojadirecta sigue teniendo mucha demanda, pero aquí reunimos una alternativa más estable con páginas por liga, equipo y partido para responder mejor a cada búsqueda.',
  },
  {
    question: '¿Cuál es la mejor alternativa a Roja Directa?',
    answer: 'rojadirectaenvivo.top combina la intención de Roja Directa, Pirlo TV, Tarjeta Roja y Fútbol Libre con una estructura más clara, enlaces internos y horarios visibles.',
  },
  {
    question: '¿Necesito VPN para ver Rojadirecta en Vivo?',
    answer: 'No. El sitio está pensado para funcionar desde navegador y ofrecer acceso rápido a los partidos disponibles sin registro.',
  },
];

const hubLinks = [
  { label: '🇲🇽 Liga MX', href: '/liga/liga-mx/' },
  { label: '🇦🇷 Liga Argentina', href: '/liga/liga-profesional-argentina/' },
  { label: '🇧🇷 Brasileirão', href: '/liga/brasileirao/' },
  { label: '🇨🇴 Liga BetPlay', href: '/liga/liga-betplay-dimayor/' },
  { label: '🇪🇨 LigaPro Ecuador', href: '/liga/ligapro-ecuador/' },
  { label: '🇺🇸 MLS', href: '/liga/mls/' },
  { label: '🌎 Copa Libertadores', href: '/liga/copa-libertadores/' },
  { label: '📅 Partidos de Hoy', href: '/partidos-de-hoy/' },
];

const internalLinks = [
  { label: '⚽ Fútbol Libre', href: '/futbol-libre/' },
  { label: '⚽ Fútbol en Vivo', href: '/futbol-en-vivo/' },
  { label: '🟥 Tarjeta Roja', href: '/tarjeta-roja/' },
  { label: '📺 Pirlo TV', href: '/pirlo-tv/' },
  { label: '🆓 Fútbol en Vivo Gratis', href: '/futbol-en-vivo-gratis/' },
  { label: '👀 Ver Fútbol Online', href: '/ver-futbol/' },
  { label: '📆 Hoy', href: '/hoy/' },
];
---

<Base title={title} description={description} canonicalUrl={canonicalUrl} matchSchema={pageSchema}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} slot="head" />

  <div class="container" style="padding-top: 32px;">
    <Breadcrumb items={breadcrumbs} />

    <section class="keyword-hero">
      <h1 class="keyword-h1">Rojadirecta en Vivo</h1>
      <p class="keyword-sub">Roja Directa hoy con prioridad para Liga MX, Libertadores y fútbol latinoamericano</p>
    </section>

    <section class="seo-text bing-resumen" style="margin-top: 0; margin-bottom: 24px;">
      <h2>Resumen rápido</h2>
      <p>
        Esta landing responde a búsquedas como <strong>rojadirecta en vivo hoy</strong> y <strong>roja directa en vivo</strong>
        mostrando partidos, ligas y rutas internas pensadas para usuarios de Latinoamérica.
      </p>
    </section>

    <div class="keyword-text">
      <p>
        <strong>Rojadirecta en Vivo</strong> es la consulta principal cuando alguien quiere encontrar fútbol en vivo gratis sin perder tiempo.
        En <strong>rojadirectaenvivo.top</strong> convertimos esa intención en una portada temática con enlaces hacia partidos individuales,
        hubs de liga y páginas de equipo que responden mejor a lo que busca el usuario.
      </p>

      <p>
        Para Bing y para las búsquedas reales del mercado hispano, no basta con mencionar ligas europeas. Por eso esta página da prioridad a
        <strong> Liga MX</strong>, <strong>fútbol argentino</strong>, <strong>Brasileirão</strong>,
        <strong> Liga BetPlay Colombia</strong>, <strong>LigaPro Ecuador</strong>, <strong>Chile</strong>,
        <strong> Uruguay</strong>, <strong>MLS</strong> y <strong>Copa Libertadores</strong>.
      </p>

      <p>
        Cuando alguien busca <strong>roja directa</strong>, normalmente quiere una respuesta inmediata: qué partidos hay, a qué hora se juegan y dónde verlos.
        Esa es la lógica de esta landing. Desde aquí puedes entrar a páginas más concretas según el torneo o el partido y encontrar una respuesta más precisa.
      </p>

      <p>
        También servimos como alternativa clara a <strong>Pirlo TV</strong>, <strong>Tarjeta Roja</strong> y <strong>Fútbol Libre</strong>.
        El objetivo no es solo atraer una keyword fuerte, sino distribuir esa autoridad hacia páginas internas con mejor oportunidad de indexar y ser citadas.
      </p>
    </div>

    <InternalLinks links={hubLinks} title="Ligas destacadas en Rojadirecta" />

    <RelatedMatches matches={events} title="Rojadirecta Hoy — Partidos en Vivo" />

    <FAQ items={faqs} />

    <InternalLinks links={internalLinks} title="Más páginas relacionadas" />

    <div style="text-align: center; margin-top: 32px; margin-bottom: 32px;">
      <a href="/" style="color: var(--c-accent); text-decoration: none; font-weight: 600;">
        ← Ver todos los partidos
      </a>
      <span style="margin: 0 16px; color: var(--c-text-muted);">|</span>
      <a href="/hoy/" style="color: var(--c-accent); text-decoration: none; font-weight: 600;">
        Partidos de Hoy →
      </a>
    </div>
  </div>
</Base>
